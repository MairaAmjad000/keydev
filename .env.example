# Base URL of the admin panel's content API, no trailing slash (e.g. https://admin.example.com/api).
# Leave empty to render the bundled content/ folder instead.
CMS_API_URL=

# Optional: bearer token if the content API is private.
CMS_API_TOKEN=

# Seconds a fetched page stays fresh before it is regenerated in the background.
CMS_REVALIDATE_SECONDS=60

# Shared secret for POST /api/revalidate (admin-panel "on publish" webhook).
CMS_REVALIDATE_SECRET=
